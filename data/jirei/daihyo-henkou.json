{
  "id": "daihyo-henkou",
  "name": "代表取締役の変更",
  "description": "取締役選任（書面決議・会社法319条1項方式）による代表取締役の変更登記。提案書兼同意書は株主ごとに1枚生成される。",
  "requiredSources": [
    { "key": "touki", "label": "登記情報（履歴事項全部証明書）", "patterns": ["履歴", "現在事項", "登記情報", "登記簿"] },
    { "key": "teikan", "label": "定款", "patterns": ["定款"] },
    { "key": "kabunushi", "label": "株主名簿", "patterns": ["株主名簿"] }
  ],
  "questions": [
    {
      "id": "new_director_name",
      "label": "新たに選任される取締役の氏名は？（例: 岩井康洋）",
      "kind": "text"
    },
    {
      "id": "new_director_address",
      "label": "新たに選任される取締役の住所は？（ビル名まで全文。2行になる場合は改行。例: 東京都台東区浅草橋四丁目１９番４－９０３号\nクラリティア浅草橋）",
      "kind": "text"
    },
    {
      "id": "retiring_director_name",
      "label": "辞任する取締役の氏名は？（例: 石橋賢人）",
      "kind": "text"
    },
    {
      "id": "retiring_director_address",
      "label": "辞任する取締役の住所は？（例: 東京都目黒区東が丘二丁目７番７号）",
      "kind": "text"
    },
    {
      "id": "kettei_date",
      "label": "取締役決定書の決定日は？（例: 令和８年３月２７日）",
      "kind": "date"
    },
    {
      "id": "teian_date",
      "label": "株主への提案書の発送日は？（例: 令和８年３月２７日）",
      "kind": "date"
    },
    {
      "id": "minashi_date",
      "label": "株主総会の決議があったものとみなされる日は？（例: 令和８年３月３０日）",
      "kind": "date"
    },
    {
      "id": "doui_date",
      "label": "同意欄の日付は？（例: 令和８年３月３０日）",
      "kind": "date"
    },
    {
      "id": "tainin_date",
      "label": "辞任届・就任承諾書・議事録の日付は？（例: 令和８年３月３０日）",
      "kind": "date"
    }
  ],
