{
  "id": "torishimariyaku-shuunin-fukusu",
  "name": "取締役就任",
  "description": "取締役が1名の株式会社において、書面決議（会社法319条1項）により複数名の取締役・代表取締役を選任する登記。提案書兼同意書は株主ごとに1枚生成される（個人用・法人用を種別で出し分け）。 当たる依頼の言い回し: 「取締役を増やしたい」「役員を追加したい」「新しく取締役に入れたい」「◯◯さんを取締役にしたい」（新任者の選任。代表取締役の選定を含む場合もこちら）",
  "requiredSources": [
    {
      "key": "touki",
      "label": "登記情報（履歴事項全部証明書）",
      "patterns": [
        "履歴",
        "現在事項",
        "登記情報",
        "登記簿"
      ]
    },
    {
      "key": "teikan",
      "label": "定款",
      "patterns": [
        "定款"
      ]
    },
    {
      "key": "kabunushi",
      "label": "株主名簿",
      "patterns": [
        "株主名簿"
      ]
    }
  ],
  "questions": [
    {
      "id": "kessai_hoho",
      "label": "株主総会の決議方法は？",
      "kind": "choice",
      "choices": [
        "書面決議（株主全員の同意・会社法319条1項）",
        "株主総会を開催"
      ]
    },
    {
      "id": "kettei_date",
      "label": "取締役決定書の決定日は？（例: 令和8年2月11日）",
      "kind": "date",
      "when": {
        "questionId": "kessai_hoho",
        "anyOf": [
          "書面決議（株主全員の同意・会社法319条1項）"
        ]
      }
    },
    {
      "id": "teian_date",
      "label": "株主への提案書の発送日は？（例: 令和8年2月11日）",
      "kind": "date",
      "when": {
        "questionId": "kessai_hoho",
        "anyOf": [
          "書面決議（株主全員の同意・会社法319条1項）"
        ]
      }
    },
    {
      "id": "doui_date",
      "label": "同意欄の日付は？（例: 令和8年2月15日）",
      "kind": "date",
      "when": {
        "questionId": "kessai_hoho",
        "anyOf": [
          "書面決議（株主全員の同意・会社法319条1項）"
        ]
      }
    },
    {
      "id": "minashi_date",
      "label": "株主総会の決議があったものとみなされる日は？（例: 令和8年2月16日）",
      "kind": "date",
      "when": {
        "questionId": "kessai_hoho",
        "anyOf": [
          "書面決議（株主全員の同意・会社法319条1項）"
        ]
      }
    },
    {
      "id": "shunin_date",
      "label": "取締役の就任日（みなし決議日と同じ場合が多い）は？（例: 令和8年2月16日）",
      "kind": "date"
    },
    {
      "id": "new_directors",
      "label": "新たに選任する取締役（1行に1人、氏名／住所。例: 山田太郎／東京都港区南麻布四丁目9番34-107号）",
      "kind": "text"
    },
    {
      "id": "new_daihyo_address",
      "label": "新代表取締役の住所は？（例: 東京都港区南麻布四丁目９番３４－１０７号）",
      "kind": "text"
    },
    {
      "id": "new_daihyo_name",
      "label": "新代表取締役の氏名は？（例: 安部和志）",
      "kind": "text"
    },
    {
      "id": "hoshu_gaku",
      "label": "取締役の報酬額（月額）は？（例: 月額金６万円）",
      "kind": "text"
    },
    {
      "id": "hoshu_kaishi",
      "label": "報酬の支給開始時期は？（例: 令和８年２月分より）",
      "kind": "text"
    }
  ],
  "guards": [
    {
      "when": {
        "questionId": "kessai_hoho",
        "anyOf": [
          "株主総会を開催"
        ]
      },
      "message": "実開催（株主総会を開く）用の議事録・招集関係の雛形が未登録です。登録済みの一式は書面決議用のみ。このまま生成すると方式に依らない書類（就任承諾書・株主リスト・委任状）だけが出ます"
    }
  ],
