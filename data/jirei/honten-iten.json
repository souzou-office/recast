        "履歴",
        "現在事項",
        "登記情報",
        "登記簿"
      ]
    },
    {
      "key": "teikan",
      "label": "定款",
      "patterns": [
        "定款"
      ]
    },
    {
      "key": "kabunushi",
      "label": "株主名簿",
      "patterns": [
        "株主名簿"
      ]
    }
  ],
