{
  "id": "mokuteki-henkou",
  "name": "目的変更",
  "description": "株式会社の事業目的を変更する登記。株主総会の特別決議で定款を変更する。",
  "requiredSources": [
    {
      "key": "touki",
      "label": "登記情報（履歴事項全部証明書）",
      "patterns": [
        "履歴",
        "現在事項",
        "登記情報",
        "登記簿"
      ]
    },
    {
      "key": "teikan",
      "label": "定款",
      "patterns": [
        "定款"
      ]
    },
    {
      "key": "kabunushi",
      "label": "株主名簿",
      "patterns": [
        "株主名簿"
      ]
    }
  ],
  "questions": [
    {
      "id": "kessai_hoho",
      "label": "株主総会の決議方法は？",
      "kind": "choice",
      "choices": [
        "書面決議（株主全員の同意・会社法319条1項）",
        "株主総会を開催"
      ]
    },
    {
      "id": "new_purpose",
      "label": "変更後の事業目的（全文・1行1項目）",
      "kind": "text"
    },
    {
      "id": "meeting_date",
      "label": "株主総会の開催日（例: 令和8年6月20日）",
      "kind": "date",
      "when": {
        "questionId": "kessai_hoho",
        "anyOf": [
          "株主総会を開催"
        ]
      }
    }
  ],
  "documents": [
    {
      "templateFile": "株主総会議事録_目的変更.docx",
      "kind": "docx",
      "when": {
        "questionId": "kessai_hoho",
        "anyOf": [
          "株主総会を開催"
        ]
      }
    },
    {
      "templateFile": "株主リスト.xlsx",
      "kind": "xlsx",
      "repeatOverFactList": "株主",
      "rowSlots": {
        "株主氏名": "氏名",
        "株主住所": "住所",
        "株主株式数": "株式数",
        "株主議決権数": "議決権数",
        "株主議決権割合": "議決権割合"
      }
    },
    {
      "templateFile": "委任状.docx",
      "kind": "docx"
    }
  ],
