{
  "id": "yakuin-henkou",
  "name": "役員変更",
  "description": "取締役の就任・辞任・重任の登記。変更の内容によって必要書類と質問が変わる。",
  "requiredSources": [
    { "key": "touki", "label": "登記情報（履歴事項全部証明書）", "patterns": ["履歴", "現在事項", "登記情報", "登記簿"] },
    { "key": "teikan", "label": "定款", "patterns": ["定款"] },
    { "key": "kabunushi", "label": "株主名簿", "patterns": ["株主名簿"] }
  ],
  "questions": [
    {
      "id": "kind",
      "label": "変更の内容は？",
      "kind": "choice",
      "choices": ["取締役の就任", "取締役の辞任", "取締役の重任"]
    },
    { "id": "target_name", "label": "対象の取締役の氏名は？" },
    {
      "id": "meeting_date",
      "label": "株主総会の開催日はいつですか？（例: 令和8年6月20日）",
      "kind": "date",
      "when": { "questionId": "kind", "anyOf": ["取締役の就任", "取締役の重任"] }
    },
    {
      "id": "nominee_address",
      "label": "就任する取締役の住所は？（就任承諾書に記載）",
      "when": { "questionId": "kind", "anyOf": ["取締役の就任", "取締役の重任"] }
    },
    {
      "id": "resign_date",
      "label": "辞任日はいつですか？（例: 令和8年6月20日）",
      "kind": "date",
      "when": { "questionId": "kind", "anyOf": ["取締役の辞任"] }
    }
  ],
  "documents": [
    {
      "templateFile": "株主総会議事録_役員選任.docx",
      "kind": "docx",
      "when": { "questionId": "kind", "anyOf": ["取締役の就任"] }
    },
    {
      "templateFile": "株主総会議事録_役員重任.docx",
      "kind": "docx",
      "when": { "questionId": "kind", "anyOf": ["取締役の重任"] }
    },
    {
      "templateFile": "就任承諾書.docx",
      "kind": "docx",
      "when": { "questionId": "kind", "anyOf": ["取締役の就任", "取締役の重任"] }
    },
    {
      "templateFile": "辞任届.docx",
      "kind": "docx",
      "placeholders": {
        "令和　　年　　月　　日": "辞任日",
        "辞任する取締役の氏名": "対象取締役氏名",
        "会社名": "会社名"
      },
      "when": { "questionId": "kind", "anyOf": ["取締役の辞任"] }
    },
    {
      "templateFile": "株主リスト.xlsx",
      "kind": "xlsx",
      "repeatOverFactList": "株主",
      "rowSlots": {
        "株主氏名": "氏名",
        "株主住所": "住所",
        "株主株式数": "株式数",
        "株主議決権数": "議決権数",
        "株主議決権割合": "議決権割合"
      },
      "when": { "questionId": "kind", "anyOf": ["取締役の就任", "取締役の重任"] }
    },
    {
      "templateFile": "委任状_役員変更.docx",
      "kind": "docx",
      "placeholders": {
        "令和　　年　　月　　日": "申請日",
        "会社の住所": "本店所在地",
        "会社名": "会社名",
        "代表取締役の氏名": "代表取締役氏名"
      }
    }
  ],
  "slots": {
    "会社名": { "type": "fact", "key": "会社名" },
    "本店所在地": { "type": "fact", "key": "本店所在地" },
    "会社法人等番号": { "type": "fact", "key": "会社法人等番号" },
    "発行済株式総数": { "type": "fact", "key": "発行済株式総数" },
    "株主総数": {
      "type": "fact", "key": "株主総数",
      "when": { "questionId": "kind", "anyOf": ["取締役の就任", "取締役の重任"] }
    },
    "議決権株主数": {
      "type": "fact", "key": "議決権株主数",
      "when": { "questionId": "kind", "anyOf": ["取締役の就任", "取締役の重任"] }
    },
    "総議決権数": {
      "type": "fact", "key": "総議決権数",
      "when": { "questionId": "kind", "anyOf": ["取締役の就任", "取締役の重任"] }
    },
    "出席株主数": {
      "type": "fact", "key": "出席株主数",
      "when": { "questionId": "kind", "anyOf": ["取締役の就任", "取締役の重任"] }
    },
    "出席議決権数": {
      "type": "fact", "key": "出席議決権数",
      "when": { "questionId": "kind", "anyOf": ["取締役の就任", "取締役の重任"] }
    },
    "議長氏名": {
      "type": "fact", "key": "代表取締役氏名",
      "when": { "questionId": "kind", "anyOf": ["取締役の就任", "取締役の重任"] }
    },
    "代表取締役氏名": { "type": "fact", "key": "代表取締役氏名" },
    "合計株式数": {
      "type": "fact", "key": "株主株式数合計",
      "when": { "questionId": "kind", "anyOf": ["取締役の就任", "取締役の重任"] }
    },
    "合計議決権数": {
      "type": "fact", "key": "株主議決権数合計",
      "when": { "questionId": "kind", "anyOf": ["取締役の就任", "取締役の重任"] }
    },
    "合計議決権割合": {
      "type": "fact", "key": "株主議決権割合合計",
      "when": { "questionId": "kind", "anyOf": ["取締役の就任", "取締役の重任"] }
    },
    "対象取締役氏名": { "type": "answer", "questionId": "target_name" },
    "開催日": {
      "type": "answer", "questionId": "meeting_date",
      "when": { "questionId": "kind", "anyOf": ["取締役の就任", "取締役の重任"] }
    },
    "作成日": {
      "type": "answer", "questionId": "meeting_date",
      "when": { "questionId": "kind", "anyOf": ["取締役の就任", "取締役の重任"] }
    },
    "証明日付": {
      "type": "answer", "questionId": "meeting_date",
      "when": { "questionId": "kind", "anyOf": ["取締役の就任", "取締役の重任"] }
    },
    "就任者住所": {
      "type": "answer", "questionId": "nominee_address",
      "when": { "questionId": "kind", "anyOf": ["取締役の就任", "取締役の重任"] }
    },
    "辞任日": {
      "type": "answer", "questionId": "resign_date",
      "when": { "questionId": "kind", "anyOf": ["取締役の辞任"] }
    },
    "申請日": [
      {
        "type": "answer", "questionId": "meeting_date",
        "when": { "questionId": "kind", "anyOf": ["取締役の就任", "取締役の重任"] }
      },
      {
        "type": "answer", "questionId": "resign_date",
        "when": { "questionId": "kind", "anyOf": ["取締役の辞任"] }
      }
    ]
  }
}
